{
  "maDVC": "2.000635.02",
  "tenThuTuc": "Cấp bản sao Trích lục hộ tịch, bản sao Giấy khai sinh",
  "states": [
    {
      "stateId": "modal_khoi_tao",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/danh-sach-thu-tuc*",
      "assistantUI": {
        "title": "Bước 1: Khởi tạo hồ sơ",
        "message": "Đang đồng bộ Cơ quan tiếp nhận...",
        "voiceText": "Đang khởi tạo hồ sơ."
      },
      "actions": [
        { "type": "delay", "ms": 1000 },
        { "type": "wait_and_click_text", "selector": "button", "text": "Xác nhận", "delayAfter": 200 }
      ]
    },
    {
      "stateId": "thong_tin_chu_ho_so",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/nop-ho-so/*",
      "assistantUI": {
        "title": "Bước 2 & 3: Xử lý biểu mẫu",
        "message": "Đang kiểm tra lịch sử đồng bộ...",
        "voiceText": ""
      },
      "actions": [
        {
          "type": "conditional_branch",
          "condition": { "type": "check_by_label", "label": "Ngày cấp" },
          "if_true": [ { "type": "delay", "ms": 200 } ],
          "if_false": [
            {
              "type": "fill_from_storage",
              "mapping": [
                { "target": "input[placeholder*='nơi cấp']", "source": "Bộ Công an" },
                { "target": "input[placeholder*='chi tiết']", "source": "{{cccdData.thuongTru}}" }
              ]
            },
            { "type": "wait_and_click", "selector": "input[type='checkbox'][name='isLuuThongTin']" },
            { "type": "wait_and_click_text", "selector": "div.el-message-box__btns button", "text": "Xác nhận", "delayAfter": 500 }
          ]
        },
        { 
          "type": "wait_and_click_text", 
          "description": "Bấm qua Bước 2",
          "selector": "button", 
          "text": "Bước tiếp theo", 
          "delayAfter": 200 
        },
        {
          "type": "delay",
          "description": "Chờ E-Form bung giao diện",
          "ms": 1000
        },
        
        {
          "type": "inject_custom_ui",
          "description": "Ghi đè giao diện Trường (5) Quan hệ bằng XPath Index bất tử",
          "title": "BƯỚC 1: CHỌN QUAN HỆ VỚI NGƯỜI ĐƯỢC CẤP:",
          "containerSelector": "xpath://*[contains(text(), '(5) Quan hệ')]/parent::*",
          "options": [
            { "label": "👤 Bản thân (Hệ thống tự điền)", "targetNativeSelector": "xpath:(//input[@name='NYC_QuanHe'])[1]" },
            { "label": "👶 Con đẻ", "targetNativeSelector": "xpath:(//input[@name='NYC_QuanHe'])[2]" },
            { "label": "👰 Vợ", "targetNativeSelector": "xpath:(//input[@name='NYC_QuanHe'])[3]" },
            { "label": "🤵 Chồng", "targetNativeSelector": "xpath:(//input[@name='NYC_QuanHe'])[4]" }
          ]
        },
        
        {
          "type": "delay",
          "description": "Chờ form gốc kích hoạt logic Auto-fill và bung các ô ẩn sau khi click Quan hệ",
          "ms": 1200
        },

        {
          "type": "inject_custom_ui",
          "description": "Ghi đè giao diện Trường (12) Loại việc",
          "title": "BƯỚC 2: CHỌN LOẠI VIỆC YÊU CẦU:",
          "containerSelector": "xpath://*[contains(text(), '(12) Loại việc')]/parent::*",
          "targetNativeSelector": "select[name='HoSo_LoaiYeuCau']",
          "options": [
            { "label": "👶 Giấy khai sinh (Bản sao)", "value": "Giấy khai sinh bản sao/Trích lục ghi vào Sổ hộ tịch việc khai sinh (bản sao)" },
            { "label": "💍 Trích lục kết hôn", "value": " Trích lục kết hôn (bản sao)/ Trích lục ghi chú kết hôn (bản sao)" },
            { "label": "⚰️ Trích lục khai tử", "value": " Trích lục khai tử (bản sao)" }
          ]
        },
        {
          "type": "wizard_step",
          "selectors": "input[name='HoSo_CoQuanDangKy']",
          "message": "Vui lòng nhập <b style='color:#D2232A'>(13) Cơ quan đã đăng ký</b>. Xong thì bấm nút bên dưới 👉",
          "voiceText": "Vui lòng nhập cơ quan đã đăng ký."
        },
        {
          "type": "wizard_step",
          "selectors": "input[name='HoSo_TenGiayTo'], input[name='HoSo_So'], input[name='HoSo_QuyenSo']",
          "message": "Vui lòng nhập <b style='color:#D2232A'>(14) Tên giấy tờ, Số và Quyển số</b>.",
          "voiceText": "Vui lòng nhập tên giấy tờ, số và quyển số."
        },
        {
          "type": "wizard_step",
          "selectors": "input[name='HoSo_NgayCapSo-day'], input[name='HoSo_NgayCapSo-month'], input[name='HoSo_NgayCapSo-year']",
          "message": "Vui lòng nhập <b style='color:#D2232A'>Ngày, tháng, năm đăng ký</b>.",
          "voiceText": "Vui lòng nhập ngày tháng năm đăng ký."
        },
        {
          "type": "wizard_step",
          "selectors": "input[name='SoLuong']",
          "message": "Vui lòng nhập <b style='color:#D2232A'>(15) Số lượng bản sao</b> cần cấp.",
          "voiceText": "Vui lòng nhập số lượng bản sao."
        },
        {
          "type": "macro_buttons",
          "message": "🎉 <b>Tuyệt vời!</b> Anh/chị đã điền xong biểu mẫu. Vui lòng chọn hành động tiếp theo:",
          "voiceText": "Đã điền xong. Vui lòng bấm Nộp ngay.",
          "buttons": [
            {
              "label": "Xem trước",
              "bgColor": "#f59e0b", "color": "#fff",
              "actions": [ { "type": "wait_and_click_text", "selector": "button", "text": "Xem trước" } ]
            },
            {
              "label": "🚀 NỘP NGAY",
              "bgColor": "#D2232A", "color": "#fff",
              "actions": [
                { "type": "wait_and_click_text", "selector": "button", "text": "Xem trước", "delayAfter": 1500 },
                { "type": "wait_and_click_text", "selector": "div.el-message-box__btns button", "text": "Xác nhận", "delayAfter": 1000 },
                { "type": "wait_and_click_text", "description": "Auto cho qua màn hình Thành phần hồ sơ", "selector": "button", "text": "Bước tiếp theo" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
