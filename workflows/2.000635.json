{
  "maDVC": "2.000635.02",
  "tenThuTuc": "Cấp bản sao Trích lục hộ tịch, bản sao Giấy khai sinh",
  "states": [
    {
      "stateId": "modal_khoi_tao",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/danh-sach-thu-tuc*",
      "assistantUI": {
        "title": "Bước 1: Khởi tạo hồ sơ",
        "message": "Đang đồng bộ Cơ quan tiếp nhận...",
        "voiceText": "Đang khởi tạo hồ sơ."
      },
      "actions": [
        { "type": "delay", "ms": 1000 },
        { "type": "wait_and_click_text", "selector": "button", "text": "Xác nhận", "delayAfter": 200 }
      ]
    },
    {
      "stateId": "thong_tin_chu_ho_so",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/nop-ho-so/*",
      "assistantUI": {
        "title": "Bước 2 & 3: Xử lý biểu mẫu",
        "message": "Đang kiểm tra lịch sử đồng bộ...",
        "voiceText": ""
      },
      "actions": [
        {
          "type": "conditional_branch",
          "condition": { "type": "check_by_label", "label": "Ngày cấp" },
          "if_true": [ { "type": "delay", "ms": 200 } ],
          "if_false": [
            {
              "type": "fill_from_storage",
              "mapping": [
                { "target": "input[placeholder*='nơi cấp']", "source": "Bộ Công an" },
                { "target": "input[placeholder*='chi tiết']", "source": "{{cccdData.thuongTru}}" }
              ]
            },
            { "type": "wait_and_click", "selector": "input[type='checkbox'][name='isLuuThongTin']" },
            { "type": "wait_and_click_text", "selector": "div.el-message-box__btns button", "text": "Xác nhận", "delayAfter": 500 }
          ]
        },
        { 
          "type": "wait_and_click_text", 
          "description": "Bấm qua Bước 2",
          "selector": "button", 
          "text": "Bước tiếp theo", 
          "delayAfter": 200 
        },
        { "type": "delay", "ms": 1000 },
        {
          "type": "inject_custom_ui",
          "title": "BƯỚC 1: CHỌN QUAN HỆ VỚI NGƯỜI ĐƯỢC CẤP:",
          "options": [
            { "label": "👤 Bản thân (Hệ thống tự điền)", "targetText": "Bản thân" },
            { "label": "👶 Con đẻ", "targetText": "Con Đẻ" },
            { "label": "👰 Vợ", "targetText": "Vợ" },
            { "label": "🤵 Chồng", "targetText": "Chồng" }
          ]
        },
        { "type": "delay", "ms": 1200 },
        {
          "type": "inject_custom_ui",
          "title": "BƯỚC 2: CHỌN LOẠI VIỆC YÊU CẦU:",
          "targetNativeSelector": "select[name='HoSo_LoaiYeuCau'], input[name='HoSo_LoaiYeuCau']",
          "options": [
            { "label": "👶 Giấy khai sinh (Bản sao)", "value": "Giấy khai sinh bản sao/Trích lục ghi vào Sổ hộ tịch việc khai sinh (bản sao)" },
            { "label": "💍 Trích lục kết hôn", "value": " Trích lục kết hôn (bản sao)/ Trích lục ghi chú kết hôn (bản sao)" },
            { "label": "⚰️ Trích lục khai tử", "value": " Trích lục khai tử (bản sao)" }
          ]
        },
        {
          "type": "ask_user_input",
          "title": "BƯỚC 3: CƠ QUAN ĐĂNG KÝ TRƯỚC ĐÂY",
          "inputs": [
            { "label": "Nhập Cơ quan đã đăng ký (13):", "targetNativeSelector": "input[name='HoSo_CoQuanDangKy']", "placeholder": "Ví dụ: UBND Phường..." }
          ]
        },
        {
          "type": "ask_user_input",
          "title": "BƯỚC 4: THÔNG TIN GIẤY TỜ",
          "inputs": [
            { "label": "Tên giấy tờ (Ví dụ: Giấy khai sinh)", "targetNativeSelector": "input[name='HoSo_TenGiayTo']" },
            { "label": "Số quyển", "targetNativeSelector": "input[name='HoSo_QuyenSo']" },
            { "label": "Số", "targetNativeSelector": "input[name='HoSo_So']" }
          ]
        },
        {
          "type": "ask_user_input",
          "title": "BƯỚC 5: NGÀY CẤP VÀ SỐ LƯỢNG",
          "inputs": [
            { 
              "label": "Ngày đăng ký (DD/MM/YYYY)", 
              "targetNativeSelector": "input[name='HoSo_NgayCapSo-day'], input[name='HoSo_NgayCapSo-month'], input[name='HoSo_NgayCapSo-year']",
              "placeholder": "Ví dụ: 25/08/2023",
              "isDateGroup": true
            },
            { 
              "label": "Số lượng bản sao cần cấp", 
              "targetNativeSelector": "input[name='SoLuong']", 
              "type": "number", 
              "placeholder": "1" 
            }
          ]
        },
        {
          "type": "macro_buttons",
          "message": "🎉 <b>Tuyệt vời!</b> Anh/chị đã điền xong biểu mẫu. Vui lòng chọn hành động tiếp theo:",
          "buttons": [
            {
              "label": "Xem trước",
              "bgColor": "#f59e0b", "color": "#fff",
              "actions": [ { "type": "wait_and_click_text", "selector": "button", "text": "Xem trước" } ]
            },
            {
              "label": "🚀 NỘP NGAY",
              "bgColor": "#D2232A", "color": "#fff",
              "actions": [
                { "type": "wait_and_click_text", "selector": "button", "text": "Xem trước", "delayAfter": 1500 },
                { "type": "wait_and_click_text", "selector": "button", "text": "Xác nhận", "delayAfter": 1000 },
                { "type": "wait_and_click_text", "selector": "button", "text": "Bước tiếp theo" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
