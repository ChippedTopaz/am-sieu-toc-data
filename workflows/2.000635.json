{
  "maDVC": "2.000635",
  "tenThuTuc": "Cấp bản sao Trích lục hộ tịch, bản sao Giấy khai sinh",
  "states": [
    {
      "stateId": "modal_khoi_tao",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/danh-sach-thu-tuc*",
      "assistantUI": {
        "title": "Bước 1: Khởi tạo hồ sơ",
        "message": "Đang chờ hệ thống đồng bộ danh mục Cơ quan tiếp nhận từ CSDL Quốc gia...",
        "voiceText": "Hệ thống đang đồng bộ dữ liệu cơ quan tiếp nhận. Vui lòng đợi trong giây lát."
      },
      "actions": [
        {
          "type": "delay",
          "description": "Chờ 2.5 giây cho API điền đủ dữ liệu vào modal",
          "ms": 2500
        },
        {
          "type": "wait_and_click_text",
          "description": "Tìm và bấm nút Xác nhận",
          "selector": "button",
          "text": "Xác nhận",
          "delayAfter": 2000
        }
      ]
    },
    {
      "stateId": "thong_tin_chu_ho_so",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/nop-ho-so/*",
      "assistantUI": {
        "title": "Bước 2: Thông tin chủ hồ sơ",
        "message": "Đang kiểm tra và đối chiếu thông tin định danh...",
        "voiceText": "Đang kiểm tra thông tin định danh."
      },
      "actions": [
        {
          "type": "conditional_branch",
          "condition": {
            "type": "check_empty",
            "selectors": ["input[placeholder='Nhập số điện thoại']", "input[placeholder='Nhập nơi cấp']"]
          },
          "if_true": [
            {
              "type": "fill_from_storage",
              "mapping": [
                { "target": "input[placeholder='Nhập nơi cấp']", "source": "Bộ Công an" },
                { "target": "input[placeholder='Nhập địa chỉ chi tiết']", "source": "{{cccdData.thuongTru}}" }
              ]
            },
            {
              "type": "highlight_missing",
              "selector": "input[placeholder='Nhập số điện thoại']"
            },
            {
              "type": "wait_for_values",
              "selectors": ["input[placeholder='Nhập số điện thoại']"]
            },
            {
              "type": "wait_and_click",
              "selector": "input[type='checkbox'][name='isLuuThongTin']"
            },
            {
              "type": "wait_and_click_text",
              "description": "Bấm Xác nhận trên hộp thoại cảnh báo nhỏ",
              "selector": "div.el-message-box__btns button",
              "text": "Xác nhận",
              "delayAfter": 1000
            }
          ],
          "if_false": []
        },
        {
          "type": "wait_and_click_text",
          "description": "Chuyển bước",
          "selector": "button",
          "text": "Bước tiếp theo"
        }
      ]
    }
  ]
}
