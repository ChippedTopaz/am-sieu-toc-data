{
  "maDVC": "2.000635",
  "tenThuTuc": "Cấp bản sao Trích lục hộ tịch, bản sao Giấy khai sinh",
  "states": [
    {
      "stateId": "modal_khoi_tao",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/danh-sach-thu-tuc*",
      "assistantUI": {
        "title": "Bước 1: Khởi tạo hồ sơ",
        "message": "Đang đồng bộ Cơ quan tiếp nhận...",
        "voiceText": "Đang khởi tạo hồ sơ."
      },
      "actions": [
        { "type": "delay", "ms": 1000 },
        { "type": "wait_and_click_text", "selector": "button", "text": "Xác nhận", "delayAfter": 200 }
      ]
    },
    {
      "stateId": "thong_tin_chu_ho_so",
      "urlPattern": "*dichvucongnganhtuphap.moj.gov.vn/nop-ho-so/*",
      "assistantUI": {
        "title": "Bước 2: Thông tin chủ hồ sơ",
        "message": "Đang kiểm tra lịch sử đồng bộ...",
        "voiceText": ""
      },
      "actions": [
        {
          "type": "conditional_branch",
          "description": "Quét xem ô Ngày cấp đã có dữ liệu chưa",
          "condition": {
            "type": "check_by_label",
            "label": "Ngày cấp"
          },
          "if_true": [
            { "type": "delay", "ms": 200 } 
          ],
          "if_false": [
            {
              "type": "fill_from_storage",
              "mapping": [
                { "target": "input[placeholder*='nơi cấp']", "source": "Bộ Công an" },
                { "target": "input[placeholder*='chi tiết']", "source": "{{cccdData.thuongTru}}" }
              ]
            },
            { "type": "wait_and_click", "selector": "input[type='checkbox'][name='isLuuThongTin']" },
            { "type": "wait_and_click_text", "selector": "div.el-message-box__btns button", "text": "Xác nhận", "delayAfter": 500 }
          ]
        },
        { 
          "type": "wait_and_click_text", 
          "description": "Bất chấp TH1 hay TH2, đều spam nút Bước tiếp theo",
          "selector": "button", 
          "text": "Bước tiếp theo", 
          "delayAfter": 200 
        }
      ]
    }
  ]
}
